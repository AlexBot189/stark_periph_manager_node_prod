{
  "can": {
    "interface": "can0",
    "arbitration_rate": 1000000,
    "data_rate": 5000000
  },
  "motors": [
    {
      "id": 1,
      "name": "right_hip",
      "heartbeat_ms": 0,
      "profile_accel": 500,
      "profile_decel": 500,
      "profile_velocity": 20,
      "disable_watchdog": true,
      "auto_enable": false,
      "tpdo_sync_count": 1
    },
    {
      "id": 2,
      "name": "left_hip",
      "heartbeat_ms": 0,
      "profile_accel": 500,
      "profile_decel": 500,
      "profile_velocity": 20,
      "disable_watchdog": true,
      "auto_enable": false,
      "tpdo_sync_count": 1
    }
  ],
  "shm": {
    "name": "/stark_shm",
    "size_kb": 64
  },
  "rt": {
    "enable_rt": true,
    "sync_enable": true,
    "sync_priority": 98,
    "sync_cpu": 1,
    "control_priority": 90,
    "recv_priority": 85,
    "recv_cpu": -1,
    "control_period_us": 1000,
    "report_divider": 1,
    "cpu_affinity": [3],
    "perf_trace": true
  },
  "calib": {
    "auto_calib": false,
    "timeout_ms": 10000,
    "threshold_deg": 1.0
  },
  "imu": {
    "i2c_dev": "/dev/i2c-3",
    "gpio_chip": "gpiochip4",
    "gpio_line": 6,
    "op_mode": 7
  },
  "report": {
    "auto_enable": true,
    "period_ms": 5,
    "data_source": "mixed"
  },
  "sensor": {
    "period_div": 4,
    "bus_format": 3,
    "mode": 3,
    "force_module": 1
  },
  "led": {
    "motor_id": 2,
    "init_off": true
  },
  "buttons": {
    "calib":  { "gpio_chip": "gpiochip0", "line": 5, "long_press_ms": 5000 },
    "report": { "gpio_chip": "gpiochip0", "line": 6 }
  },
  "ros": {
    "enabled": false,
    "feedback_topic": "/stark/motor/feedback",
    "state_topic": "/stark/motor/state",
    "ctrl_sub_topic": "/stark/motor/ctrl"
  },
  "web": {
    "enabled": false,
    "port": 8080,
    "push_period_ms": 5
  },
  "foot_pressure": {
    "enabled": true,
    "uart_dev": "/dev/ttyS7",
    "baud_rate": 460800,
    "timeout_ms": 10
  }
}
