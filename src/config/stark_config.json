{
  "can": {
    "interface": "can0",
    "arbitration_rate": 1000000,
    "data_rate": 5000000
  },
  "motors": [
    {
      "id": 1,
      "name": "right_hip",
      "heartbeat_ms": 0,
      "profile_accel": 500,
      "profile_decel": 500,
      "profile_velocity": 20,
      "disable_watchdog": true,
      "auto_enable": false,
      "tpdo_sync_count": 1
    },
    {
      "id": 2,
      "name": "left_hip",
      "heartbeat_ms": 0,
      "profile_accel": 500,
      "profile_decel": 500,
      "profile_velocity": 20,
      "disable_watchdog": true,
      "auto_enable": false,
      "tpdo_sync_count": 1
    }
  ],
  "shm": {
    "name": "/stark_shm",
    "size_kb": 64
  },
  "rt": {
    "enable_rt": true,
    "sync_enable": true,
    "sync_priority": 98,
    "sync_cpu": 1,
    "control_priority": 90,
    "recv_priority": 85,
    "recv_cpu": -1,
    "control_period_us": 1000,
    "report_divider": 1,
    "cpu_affinity": [3],
    "perf_trace": true
  },
  "calib": {
    "auto_calib": false,
    "timeout_ms": 10000,
    "threshold_deg": 1.0
  },
  "sensor": {
    "period_div": 4,
    "bus_format": 3,
    "mode": 3,
    "force_module": 1,
    "imu": {
      "driver": "invensense",
      "interface": "spi",
      "i2c_dev": "/dev/i2c-3",
      "spi_dev": "/dev/spidev0.0",
      "spi_speed_hz": 8000000,
      "spi_mode": 0,
      "gpio_chip": "gpiochip4",
      "gpio_line": 3,
      "op_mode": 7
    },
    "foot_pressure": {
      "enabled": true,
      "uart_dev": "/dev/ttyS7",
      "baud_rate": 460800,
      "timeout_ms": 10
    },
    "barometer": {
      "enabled": true,
      "input_name": "bmp5xy",
      "sample_period_ms": 50,
      "osr_t": 6,
      "osr_p": 2,
      "odr": 15,
      "power_mode": 3,
      "iir_p": 3,
      "iir_t": 3,
      "sea_level_hpa": 1013.25
    }
  },
  "report": {
    "auto_enable": true,
    "period_ms": 5,
    "data_source": "mixed"
  },
  "led": {
    "motor_id": 2,
    "init_off": true
  },
  "buttons": {
    "calib":  { "gpio_chip": "gpiochip0", "line": 5, "long_press_ms": 5000 },
    "report": { "gpio_chip": "gpiochip0", "line": 6 }
  },
  "ros": {
    "enabled": true
  },
  "web": {
    "enabled": true,
    "port": 8080,
    "push_period_ms": 5
  }
}
