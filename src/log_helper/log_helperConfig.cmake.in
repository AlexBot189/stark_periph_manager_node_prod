include(${CMAKE_CURRENT_LIST_DIR}/log_helperTargetConfig.cmake)

get_filename_component(CONFIG_PATH "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
get_filename_component(INSTALL_PATH "${CONFIG_PATH}/../../../" REALPATH)
set(__log_helper_INCLUDE_DIRS ${INSTALL_PATH}/include)
set(__log_helper_LIBRARIES ${INSTALL_PATH}/lib/log_helper/liblog_helper.so)

set(log_helper_INCLUDE_DIRS "")
foreach(d ${__log_helper_INCLUDE_DIRS})
  get_filename_component(__d "${d}" REALPATH)
  list(APPEND log_helper_INCLUDE_DIRS "${__d}")
endforeach()
unset(__d)

set(log_helper_LIBRARIES "")
get_filename_component(__l "${__log_helper_LIBRARIES}" REALPATH)
list(APPEND log_helper_LIBRARIES "${__l}")
unset(__l)
